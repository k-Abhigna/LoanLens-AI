	partition EMI_Schedule = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\emi_schedule.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.TransformColumns(Headers, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Loan_ID", type text}, {"Installment_No", Int64.Type}, {"Due_Date", type date}, {"Paid_Date", type date}, {"EMI_Amount", type number}, {"Principal_Component", type number}, {"Interest_Component", type number}, {"Late_Fee", type number}, {"Outstanding_Balance", type number}, {"Status", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
