table Loans
	lineageTag: c90be8f4-cd8c-5b9e-9247-2454988617b9

	/// Sum of sanctioned principal across loans (INR)
	measure 'Total Principal' = SUM ( Loans[Principal_Amount] )
		formatString: #,##0
		lineageTag: b1112e79-a4ec-5637-9e82-2024f1bec5e0

	/// Sum of EMIs paid to date (INR)
	measure 'Total EMI Collected' = SUM ( Loans[Total_Paid] )
		formatString: #,##0
		lineageTag: 63d62a96-ee7f-5b2a-aaeb-c2df24f9e2e3

	/// Sum of late payment charges (INR)
	measure 'Total Late Fees' = SUM ( Loans[Late_Fees] )
		formatString: #,##0.00
		lineageTag: 430d9b02-557b-5c1e-9b8c-7682f55bcc7a

	/// Average annual interest rate (percent)
	measure 'Average Interest Rate' = AVERAGE ( Loans[Interest_Rate] )
		formatString: 0.00
		lineageTag: 3e58097d-d275-594c-beec-0ccd45fa72c1

	/// Share of loans with at least one late payment
	measure 'Late Payment %' = DIVIDE ( CALCULATE ( COUNTROWS ( Loans ), Loans[Late_Fees] > 0 ), COUNTROWS ( Loans ), 0 )
		formatString: 0.0%
		lineageTag: 10453bb3-3555-5e66-b988-06306e4a4ae0

	/// Principal still to be repaid (INR)
	measure 'Outstanding Principal' = SUM ( Loans[Outstanding_Principal] )
		formatString: #,##0
		lineageTag: 91bfe94a-2b99-508c-a36d-0d2602929359

	/// Number of instalments paid late
	measure 'Late Instalments' = CALCULATE ( COUNTROWS ( EMI_Schedule ), EMI_Schedule[Status] = "Paid Late" )
		formatString: 0
		lineageTag: 5eca0294-001e-55f3-9b37-92fc3a4f23e4

