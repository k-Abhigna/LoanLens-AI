	partition Loans = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\loans.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.TransformColumns(Headers, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Loan_ID", type text}, {"Receipt_ID", type text}, {"Lender", type text}, {"Loan_Type", type text}, {"Borrower", type text}, {"Principal_Amount", type number}, {"Interest_Rate", type number}, {"Tenure_Months", Int64.Type}, {"EMI_Amount", type number}, {"Disbursement_Date", type date}, {"Installments_Paid", Int64.Type}, {"Total_Paid", type number}, {"Principal_Repaid", type number}, {"Interest_Paid", type number}, {"Late_Fees", type number}, {"Outstanding_Principal", type number}, {"Next_Due_Date", type date}, {"Source", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
