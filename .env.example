# Copy this file to .env and add your key(s). Never commit .env.

# Google Gemini free tier - key from https://aistudio.google.com/apikey
# Used for document extraction AND for Q&A answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT=180

# Optional: answer Q&A questions with Claude instead (used when no Gemini key is set)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional: force the Q&A answer provider: gemini | anthropic | extractive (offline, no model)
LLM_PROVIDER=
