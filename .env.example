# Copy this file to .env and add your key. Never commit .env.
# LoanLens uses ONE LLM for both document extraction and Q&A answers.

# Option A (default): Google Gemini free tier - key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT=180

# Option B: Claude. Set the key and LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# gemini | anthropic | none (offline: rules extraction + extractive answers).
# Empty = Gemini if GEMINI_API_KEY is set, else Claude if ANTHROPIC_API_KEY is set, else none.
LLM_PROVIDER=

# Set to 0 to stop writing data/llm_traces.jsonl
LOANLENS_TRACE=1
